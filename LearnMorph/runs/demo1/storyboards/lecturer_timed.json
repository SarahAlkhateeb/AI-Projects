          "end_s": 12.7
        },
        {
          "phrase": "For 2 to the x, the derivative was 0.693 times 2 to the x.",
          "template": "equation",
          "props": {
            "tex": "\\frac{d}{dx}\\,2^x = 0.693\\cdot 2^x",
            "highlight": "0.693"
