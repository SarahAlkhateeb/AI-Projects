            "to_tex": "f'(x)=\\lim_{h\\to 0}\\frac{\\textcolor{red}{a^{x}}\\textcolor{orange}{(a^{h}-1)}}{\\textcolor[HTML]{7FC8FF}{h}}",
            "highlight": "a^{x}"
