          "props": {
            "tex": "\\begin{aligned}\\frac{d}{dx}\\,2^x &= 0.693\\cdot 2^x\\\\ \\frac{d}{dx}\\,3^x &= 1.099\\cdot 3^x\\end{aligned}",
            "highlight": "1.099"
