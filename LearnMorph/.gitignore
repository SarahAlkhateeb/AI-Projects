# Secrets (.env.example holds placeholders only and is tracked)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# OS / tooling
.DS_Store
.claude/
.learnmorph/
diag.command

# Third-party teacher material: regenerated locally, never committed
data/
runs/*/corpus/
runs/*/profiles/*/segmented.json
runs/*/profiles/*/exemplars.json
runs/*/profiles/*/frames/

# Run bulk (keep only text artefacts)
runs/*/attempts/
runs/*/candidates/
runs/*/scores/
runs/*/tts_work/
runs/*/peek/
runs/*/v1_attempt/
runs/*.log
runs/*/video/*
!runs/*/video/*_qa_r*.json

# Remotion
remotion/node_modules/
remotion/node_modules*
remotion/out/
remotion/public/audio/
remotion/public/*
!remotion/public/*.json

# Legacy v1 outputs
legacy/outputs/
legacy/media/
outputs/

# Media and binaries
*.mp4
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.pdf
*.onnx
*.bin
*.tgz
