# Copy this file to .env and replace each <fill-in-...> with your real key.
# .env is gitignored — NEVER paste real keys into this template file.

# Required from Phase 1 onward (Claude is the brain of the pipeline)
ANTHROPIC_API_KEY=<fill-in-your-anthropic-key>

# Optional (Phase 2+) — Gemini takes mp4 natively for the visual extraction step.
# Free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=<fill-in-or-leave-blank>

# Optional (Phase 3+) — premium narration voice cloning.
# Free tier 10k chars/mo: https://elevenlabs.io
ELEVENLABS_API_KEY=<fill-in-or-leave-blank>
